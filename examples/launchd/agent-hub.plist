<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent for agent-hub. Replace the label, the paths, and the
  PATH entries (op and uv must be on it), copy to ~/Library/LaunchAgents/,
  then: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/<file>
  For a second instance, use another label and set AGENT_HUB_CONFIG.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.agent-hub</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/you/src/agent-hub/run-hub</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>AGENT_HUB_CONFIG</key>
    <string>/Users/you/.config/agent-hub/hub.toml</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/you/Library/Logs/agent-hub/hub.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/you/Library/Logs/agent-hub/hub.err.log</string>
</dict>
</plist>
